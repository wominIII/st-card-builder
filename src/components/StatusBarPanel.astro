              if(filterFn(d)) {
                  toAdd.push({
                      comment: d.comment,
                      content: d.content,
                      keys: d.keys,
                      strategy: d.strategy,
                      position: 4,
                      depth: d.layer === 'blue' ? 2 : 4,
                      role: 0,
                      order: 800,
                      prob: 100,
                      enabled: true
                  });
              }
          }
      });

      window.__setWorldbookEntries__(kept.concat(toAdd));
      if(window.dispatchEvent) {
          window.dispatchEvent(new Event('worldbook-changed'));
          window.dispatchEvent(new Event('card-builder-data-changed'));
      }
      alert('已应用 ' + toAdd.length + ' 个条目');
      renderAll();
  }

  btnApplyAll.addEventListener('click', () => applyDrafts(d => !d.warnings || d.warnings.length === 0));
  btnApplyGreen.addEventListener('click', () => applyDrafts(d => d.layer === 'green' && (!d.warnings || d.warnings.length === 0)));
  btnApplyBlue.addEventListener('click', () => applyDrafts(d => d.layer === 'blue' && (!d.warnings || d.warnings.length === 0)));
  btnApplySelected.addEventListener('click', () => applyDrafts(d => true));

  btnUndoApply.addEventListener('click', function() {
      var snap = localStorage.getItem('novelWorkshopSnapshotV2');
      if(snap && window.__setWorldbookEntries__) {
          window.__setWorldbookEntries__(JSON.parse(snap));
          localStorage.removeItem('novelWorkshopSnapshotV2');
          if(window.dispatchEvent) {
              window.dispatchEvent(new Event('worldbook-changed'));
              window.dispatchEvent(new Event('card-builder-data-changed'));
          }
          alert('已撤销');
          renderAll();
      }
  });

  btnCancelDraft.addEventListener('click', function() {
      state.drafts = [];
      persistCurrentProject();
      renderAll();
  });

  async function loadInitialState() {
      var lastId = localStorage.getItem('novel_last_project');
      if (lastId) {
          var saved = await loadStateDB(lastId);
          if (saved) {
              if (!saved.schemaVersion || saved.schemaVersion < 3) {
                  alert('旧版分析结果不兼容，已保留原文，请重新开始新版分析。');
                  state.fileText = saved.fileText || '';
                  state.sourceText = saved.sourceText || '';
                  state.contextText = saved.contextText || '';
                  state.importedFileName = saved.importedFileName || '';
                  state.narrativeMode = saved.narrativeMode || state.narrativeMode;
                  state.chunkSize = saved.chunkSize || state.chunkSize;
                  state.concurrency = saved.concurrency || state.concurrency;
                  state.strictQuality = Boolean(saved.strictQuality);
                  state.focus = Array.isArray(saved.focus) ? saved.focus : state.focus;
                  state.projectId = generateProjectId();
                  await persistCurrentProject();
              } else {
                  Object.assign(state, saved);
                  state.tasks = Array.isArray(state.tasks) ? state.tasks : [];
                  state.importedFileLength = state.importedFileLength || (state.fileText ? state.fileText.length : 0);

                  if (state.tasks && state.tasks.length > 0 && !state.analysisSignature) {
                      if (state.importedFileName && !state.fileText) {
                          state.analysisSignature = state.projectId || 'awaiting-source-file';
                          if (!['paused', 'error', 'completed'].includes(state.phase)) state.phase = 'paused';
                          addDiagnosticLog('warning', '状态恢复', '旧项目缺少原文件，请补选同一文件以恢复断点');
                      } else {
                          var migratedFullText = ((state.fileText || '') + '\n' + state.sourceText).trim();
                          var migratedTaskText = state.tasks.map(task => task.text || '').join('');
                          if (migratedTaskText === migratedFullText) {
                          var migratedSignature = generateProjectId();
                          state.analysisSignature = migratedSignature;
                          state.projectId = migratedSignature;
                          addDiagnosticLog('info', '状态恢复', '旧版分析签名已迁移，断点进度已保留');
                          } else {
                              state.phase = 'idle';
                              state.analysisSignature = '';
                              state.projectId = generateProjectId();
                              state.tasks = [];
                              state.drafts = [];
                              state.canonicalEntities = [];
                              state.aggregatedData = {};
                              addDiagnosticLog('warning', '状态恢复', '旧版切片与当前原文不一致，已作废旧分析结果');
                          }
                      }
                  }

                  if ((!state.tasks || state.tasks.length === 0) && state.phase === 'completed') {
                      state.phase = 'idle';
                      state.drafts = [];
                      state.canonicalEntities = [];
                      state.aggregatedData = {};
                      addDiagnosticLog('warning', '状态恢复', '检测到异常的完成状态（无任务），已自动修复为等待开始');
                  }
              }
              if (!state.resolvingProgress) state.resolvingProgress = { cursor: 0, nextPackages: [], unresolvedGroups: [], attempts: 0, error: null };
              if (!Array.isArray(state.resolvingProgress.nextPackages)) state.resolvingProgress.nextPackages = [];
              if (!Array.isArray(state.resolvingProgress.unresolvedGroups)) state.resolvingProgress.unresolvedGroups = [];
              if (!state.draftingProgress) state.draftingProgress = { cursor: 0, entities: [] };
              if (!Array.isArray(state.draftingProgress.entities)) state.draftingProgress.entities = [];
              if (['mentions', 'narrative', 'resolving', 'aggregating', 'drafting'].includes(state.phase)) {
                  state.phase = 'paused';
                  state.tasks.forEach(t => {
                      if(t.mentionsStatus === 'running') t.mentionsStatus = 'pending';
                      if(t.narrativeStatus === 'running') t.narrativeStatus = 'pending';
                  });
              }
              if(state.importedFileName && !state.fileText) {
                  // File text needs to be re-imported manually because we can't persist large file text easily or it might exceed quota,
                  // or user refreshed. Wait for them to re-select if needed.
              }

              var msg = '已恢复项目。';
              if(state.tasks.length > 0) {
                  var successCount = state.tasks.filter(t=>t.narrativeStatus==='success').length;
                  msg = `已恢复进度: 完成 ${successCount}/${state.tasks.length}`;
              }
              statusTextEl.textContent = msg;
              addDiagnosticLog('info', '工作流', '已恢复本地项目', {
                  reason: state.phase === 'paused' ? '检测到未完成任务，已转为暂停状态' : '恢复缓存状态'
              });
              await persistCurrentProject();
          }
      }
      renderAll();
  }


  var isDiagExpanded = null;

  function renderDiagnosticLogs() {
      var logs = state.diagnosticLogs || [];
      var badge = document.getElementById('diagBadge');
      if (badge) {
          var errCount = logs.filter(l => l.level === 'error').length;
          var warnCount = logs.filter(l => l.level === 'warning').length;
          var txt = '';
          if (errCount > 0) txt += '<span style="color:#f87171;">' + errCount + ' 错误</span> ';
          if (warnCount > 0) txt += '<span style="color:#fcd34d;">' + warnCount + ' 警告</span> ';
          if (!txt) txt = logs.length + ' 条';
          badge.innerHTML = '(' + txt.trim() + ')';
      }

      var contentEl = document.getElementById('diagnosticContent');
      var listEl = document.getElementById('diagnosticLogList');
      var chevronEl = document.getElementById('diagChevron');

      if (!contentEl || !listEl) return;

      if (logs.length === 0) {
          listEl.innerHTML = '<div style="color:#64748b; font-size:0.7rem; text-align:center; padding:10px;">暂无诊断日志</div>';
      } else {
          listEl.innerHTML = logs.map((l, i) => {
              var color = l.level === 'error' ? '#f87171' : (l.level === 'warning' ? '#fcd34d' : '#94a3b8');
              var bg = l.level === 'error' ? 'rgba(248,113,113,0.1)' : (l.level === 'warning' ? 'rgba(252,211,77,0.1)' : 'transparent');
              var timeStr = new Date(l.timestamp).toLocaleTimeString();

              var detailsHtml = '';
              if (l.details) {
                  var detailKeys = Object.keys(l.details).filter(k => k !== 'response_excerpt');
                  if (detailKeys.length > 0) {
                      detailsHtml += '<div style="margin-top:4px; font-size:0.65rem; color:#64748b; display:flex; flex-wrap:wrap; gap:6px;">';
                      detailKeys.forEach(k => {
                          detailsHtml += '<span style="background:rgba(15,23,42,0.5); padding:2px 4px; border-radius:4px;">' + escapeHtml(k) + ': ' + escapeHtml(l.details[k]) + '</span>';
                      });
                      detailsHtml += '</div>';
                  }
                  if (l.details.response_excerpt) {
                      detailsHtml += '<details style="margin-top:4px;"><summary style="font-size:0.65rem; color:#64748b; cursor:pointer;">展开响应片段</summary><pre style="margin:4px 0 0 0; padding:6px; background:rgba(2,6,23,0.6); border-radius:4px; font-size:0.6rem; color:#cbd5e1; white-space:pre-wrap; word-break:break-all; max-height:100px; overflow-y:auto;">' + escapeHtml(l.details.response_excerpt) + '</pre></details>';
                  }
              }

              return '<div style="padding:8px; border-radius:6px; background:' + bg + '; border-left:2px solid ' + color + ';">' +
                     '<div style="display:flex; justify-content:space-between; margin-bottom:4px;">' +
                     '<span style="font-size:0.65rem; color:#64748b;">' + timeStr + ' [' + escapeHtml(l.stage) + ']</span>' +
                     '<span style="font-size:0.65rem; font-weight:bold; color:' + color + ';">' + l.level.toUpperCase() + '</span>' +
                     '</div>' +
                     '<div style="font-size:0.75rem; color:#e2e8f0; word-break:break-word;">' + escapeHtml(l.message) + '</div>' +
                     detailsHtml +
                     '</div>';
          }).join('');
      }

      if (isDiagExpanded || (logs.some(l => l.level === 'error') && isDiagExpanded === null)) {
          contentEl.style.display = 'block';
          if(chevronEl) chevronEl.textContent = '▲';
          isDiagExpanded = true;
      } else {
          contentEl.style.display = 'none';
          if(chevronEl) chevronEl.textContent = '▼';
          if (isDiagExpanded === null) isDiagExpanded = false;
      }
  }

  document.addEventListener('click', function(e) {
      if (e.target.closest('#btnToggleDiagnostics')) {
          isDiagExpanded = !isDiagExpanded;
          renderDiagnosticLogs();
      }
      if (e.target.closest('#btnClearDiag')) {
          state.diagnosticLogs = [];
          persistCurrentProject();
          renderDiagnosticLogs();
      }
      if (e.target.closest('#btnCopyDiag')) {
          if (!state.diagnosticLogs || state.diagnosticLogs.length === 0) return alert('没有日志可复制');
          if (!navigator.clipboard || !navigator.clipboard.writeText) return alert('当前浏览器不支持剪贴板写入，请使用“导出 JSON”');
          navigator.clipboard.writeText(JSON.stringify(getSanitizedDiagnosticLogs(), null, 2))
              .then(() => { var btn = document.getElementById('btnCopyDiag'); var old = btn.textContent; btn.textContent = '已复制'; setTimeout(()=>btn.textContent=old, 2000); })
              .catch(err => alert('复制失败: ' + err));
      }
      if (e.target.closest('#btnExportDiag')) {
          if (!state.diagnosticLogs || state.diagnosticLogs.length === 0) return alert('没有日志可导出');
          var exportData = {
              schemaVersion: state.schemaVersion,
              exportedAt: new Date().toISOString(),
              projectId: state.projectId,
              config: {
                  narrativeMode: state.narrativeMode,
                  chunkSize: state.chunkSize,
                  concurrency: state.concurrency,
                  focus: state.focus,
                  strictQuality: state.strictQuality,
                  model: document.getElementById('modelSelect') ? document.getElementById('modelSelect').value : 'unknown',
                  apiHost: document.getElementById('apiUrl') ? (function(){ try{ return new URL(document.getElementById('apiUrl').value).host; } catch(e){ return 'unknown'; } })() : 'unknown'
              },
              logs: getSanitizedDiagnosticLogs()
          };
          var blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          var pad = (n) => String(n).padStart(2, '0');
          var d = new Date();
          a.download = 'novel-diagnostics-' + d.getFullYear() + pad(d.getMonth()+1) + pad(d.getDate()) + '-' + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds()) + '.json';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
      }
  });

  loadInitialState();
})();
</script>
