  async function handleTaskError(task, stage, e) {
      var statusKey = stage + 'Status';
      var attemptsKey = stage + 'Attempts';
      var errorKey = stage + 'Error';

      task.startedAt = null;

      if (e.name === 'AbortError' || e.message === 'AbortError') {
          task[statusKey] = 'pending';
          task[attemptsKey]--;
          return;
      }

      var errMsg = e.message === '429' ? 'Rate Limit (429)' : e.message;
      task[errorKey] = errMsg;

      var waitTime = 0;
      if (task[attemptsKey] < 3) {
          waitTime = e.name === 'TimeoutError' ? 1000 + Math.random() * 1000 : (e.message === '429' ? 2000 * Math.pow(2, task[attemptsKey] - 1) : 1000);
      }

      addDiagnosticLog(task[attemptsKey] >= 3 ? 'error' : 'warning', stage === 'mentions' ? '提及提取' : '叙事解析', '任务执行异常', {
          chunk_id: task.chunk_id,
          chapter_title: task.meta.chapter_title,
          attempt: task[attemptsKey],
          max_attempts: 3,
          error: errMsg,
          http_status: e.httpStatus,
          duration_ms: e.durationMs,
          model: e.model,
          api_host: e.apiHost,
          response_excerpt: e.responseExcerpt,
          wait_time_ms: waitTime
      });

      if (task[attemptsKey] >= 3) {
          task[statusKey] = 'failed';
      } else {
          task[statusKey] = 'pending';
          await new Promise(r => setTimeout(r, waitTime));
      }
      await persistCurrentProject();
  }

  function groundQuotes(items, text, chunkStartOffset) {
      if (!items || !Array.isArray(items)) return;
      items.forEach(item => {
          if (!item.quote) {
              item.grounded = false;
              item.match_method = 'none';
              return;
          }
          // Exact match
          var idx = text.indexOf(item.quote);
          if (idx >= 0) {
              item.start = idx;
              item.end = idx + item.quote.length;
              item.chunk_source_start = chunkStartOffset;
              item.global_start = chunkStartOffset + item.start;
              item.global_end = chunkStartOffset + item.end;
              item.grounded = true;
              item.match_method = 'exact';
              return;
          }

          // Normalized match (strip whitespace/punctuation)
          var normText = '';
          var indexMap = [];
          for (var i = 0; i < text.length; i++) {
              var char = text[i];
              if (!/[\s\p{P}]/u.test(char)) {
                  normText += char;
                  indexMap.push(i);
              }
          }

          var normQuote = item.quote.replace(/[\s\p{P}]/gu, '');
          var normIdx = normText.indexOf(normQuote);
          if (normIdx >= 0) {
              item.start = indexMap[normIdx];
              item.end = indexMap[normIdx + normQuote.length - 1] + 1;
              item.chunk_source_start = chunkStartOffset;
              item.global_start = chunkStartOffset + item.start;
              item.global_end = chunkStartOffset + item.end;
              item.grounded = true;
              item.match_method = 'normalized';
              return;
          }

          item.grounded = false;
          item.match_method = 'none';
      });
  }

  async function performResolving() {
      statusTextEl.textContent = '实体消歧中...';

      // 收集所有mentions
      var allMentions = [];
      state.tasks.forEach(t => {
          if (t.mentionsStatus === 'success' && t.mentionsResult && t.mentionsResult.mentions) {
              t.mentionsResult.mentions.forEach((m, mentionIndex) => {
                  allMentions.push({
                      ...m,
                      mention_ref: `${t.chunk_id}:m:${mentionIndex}`,
                      _chunk_id: t.chunk_id
                  });
              });
          }
      });

      // 简单本地规范化生成候选
      var localCandidatesMap = {};
      allMentions.forEach(m => {
          var normName = String(m.name || '').trim();
          if (!normName) return;
          if (!localCandidatesMap[normName]) {
              localCandidatesMap[normName] = { name: normName, type: m.type, aliases: new Set(), refs: [] };
          }
          if (m.aliases) m.aliases.forEach(a => localCandidatesMap[normName].aliases.add(a));
          localCandidatesMap[normName].refs.push(m);
      });

      var candidateList = Object.values(localCandidatesMap).map(c => ({
          name: c.name,
          type: c.type,
          aliases: Array.from(c.aliases),
          mention_count: c.refs.length,
          mention_refs: c.refs.map(r => r.mention_ref),
          evidence: c.refs.filter(r => r.grounded).slice(0, 3).map(r => r.quote)
      }));

      if (!state.resolvingProgress) state.resolvingProgress = { cursor: 0, nextPackages: [], unresolvedGroups: [], attempts: 0, error: null };
      if (!Array.isArray(state.resolvingProgress.nextPackages)) state.resolvingProgress.nextPackages = [];
      if (!Array.isArray(state.resolvingProgress.unresolvedGroups)) state.resolvingProgress.unresolvedGroups = [];
      var batchSize = 50; // names per batch

      while (state.resolvingProgress.cursor < candidateList.length) {
          if (abortController.signal.aborted) return;
          var batchStart = state.resolvingProgress.cursor;
          var batch = [];
          var batchChars = 0;
          while (batchStart + batch.length < candidateList.length && batch.length < batchSize) {
              var candidate = candidateList[batchStart + batch.length];
              var candidateChars = JSON.stringify(candidate).length;
              if (batch.length > 0 && batchChars + candidateChars > 25000) break;
              batch.push(candidate);
              batchChars += candidateChars;
          }

          statusTextEl.textContent = `实体消歧批次 (${state.resolvingProgress.cursor}/${candidateList.length})...`;

          var prompt = `[novel-resolve-v2] You are a Lore Master. Resolve and disambiguate entities from the provided list.
CRITICAL REQUIREMENTS:
1. Merge entities that clearly refer to the same concept/person.
2. DO NOT force merge uncertain entities. Put them in unresolved_groups.
3. Keep mention_refs for mapping back.
4. Output JSON only.

JSON Schema:
{
  "canonical_entities": [
    { "name": "Primary Name", "type": "...", "aliases": ["alias1"], "mention_refs": ["0:m:1"] }
  ],
  "unresolved_groups": [
    { "names": ["Ambiguous1", "Ambiguous2"], "reason": "Not enough context" }
  ]
}

Candidates:
${JSON.stringify(batch)}`;

          try {
              state.resolvingProgress.attempts = (state.resolvingProgress.attempts || 0) + 1;
              var aiRes = await callAI(prompt, abortController.signal);
              var res = aiRes.data;
              var resolvedEntities = Array.isArray(res.canonical_entities) ? res.canonical_entities : [];
              {
                  var batchIdx = batchStart;
                  resolvedEntities.forEach((ce, idx) => {
                      ce.id = `ce_${batchIdx}_${idx}`;
                      var refs = new Set(Array.isArray(ce.mention_refs) ? ce.mention_refs : []);
                      var matchedCandidates = batch.filter(cand => cand.mention_refs.some(ref => refs.has(ref)) || cand.name === ce.name || (ce.aliases || []).includes(cand.name));
                      ce.aliases = Array.from(new Set([].concat(ce.aliases || [], matchedCandidates.map(cand => cand.name), ...matchedCandidates.map(cand => cand.aliases || [])))).filter(alias => alias && alias !== ce.name);
                  });

                  // fallback for missed candidates
                  var processedNames = new Set();
                  resolvedEntities.forEach(ce => {
                      processedNames.add(ce.name);
                      if (ce.aliases) ce.aliases.forEach(a => processedNames.add(a));
                  });
                  batch.forEach(cand => {
                      if (!processedNames.has(cand.name)) {
                          resolvedEntities.push({
                              id: `ce_${batchIdx}_miss_${cand.name}`,
                              name: cand.name, type: cand.type, aliases: cand.aliases, mention_refs: cand.mention_refs
                          });
                      }
                  });

                  state.resolvingProgress.nextPackages = state.resolvingProgress.nextPackages.concat(resolvedEntities);
              }
              if (res.unresolved_groups) {
                  state.resolvingProgress.unresolvedGroups = state.resolvingProgress.unresolvedGroups.concat(res.unresolved_groups);
              }

              addDiagnosticLog('info', '实体消歧', '批次处理成功', {
                  batch_start: batchStart,
                  batch_size: batch.length,
                  attempt: state.resolvingProgress.attempts,
                  max_attempts: 3,
                  duration_ms: aiRes.duration,
                  model: aiRes.model,
                  api_host: aiRes.apiHost
              });
              state.resolvingProgress.cursor += batch.length;
              state.resolvingProgress.error = null;
              state.resolvingProgress.attempts = 0;
              await persistCurrentProject();
          } catch(e) {
              if (e.name === 'AbortError') return;
              var errMsg = e.message === '429' ? 'Rate Limit (429)' : e.message;
              state.resolvingProgress.error = errMsg;

              var waitTime = 0;
              if (state.resolvingProgress.attempts < 3) {
                  waitTime = e.message === '429' ? 2000 * Math.pow(2, state.resolvingProgress.attempts - 1) : 1000;
              }

              addDiagnosticLog(state.resolvingProgress.attempts >= 3 ? 'error' : 'warning', '实体消歧', '批次处理异常', {
                  batch_start: batchStart,
                  batch_size: batch.length,
                  attempt: state.resolvingProgress.attempts,
                  max_attempts: 3,
                  error: errMsg,
                  http_status: e.httpStatus,
                  duration_ms: e.durationMs,
                  model: e.model,
                  api_host: e.apiHost,
                  response_excerpt: e.responseExcerpt,
                  wait_time_ms: waitTime
              });

              await persistCurrentProject();
              if (state.resolvingProgress.attempts >= 3) {
                  pauseWithFailed('实体消歧');
                  return;
              } else {
                  await new Promise(r => setTimeout(r, waitTime));
              }
          }
      }

      if (state.resolvingProgress.error) return; // paused
      state.canonicalEntities = state.resolvingProgress.nextPackages;
      state.unresolvedGroups = state.resolvingProgress.unresolvedGroups;
      await persistCurrentProject();
