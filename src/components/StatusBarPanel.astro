  async function performAggregation() {
      var agg = {};
      state.canonicalEntities.forEach(ce => {
          if (!agg[ce.id]) {
              agg[ce.id] = { id: ce.id, name: ce.name, type: ce.type, aliases: ce.aliases || [], mentions: [], grounded_evidence: [], ungrounded_evidence: [], events: [], state_changes: [], relations: [] };
          }
      });

      var aliasToId = {};
      state.canonicalEntities.forEach(ce => {
          var n = (ce.name || '').trim();
          if (n) aliasToId[n] = ce.id;
          (ce.aliases || []).forEach(a => {
              var an = (a || '').trim();
              if (an && !aliasToId[an]) aliasToId[an] = ce.id;
          });
      });

      function resolveId(name) { return aliasToId[(name || '').trim()] || null; }

      state.unresolvedData = { mentions: [], unresolved_mentions: [], events: [], state_changes: [], relations: [] };

      state.tasks.forEach(t => {
          if (t.mentionsResult && t.mentionsResult.mentions) {
              t.mentionsResult.mentions.forEach(m => {
                  var cid = resolveId(m.name);
                  var mData = { ...m, chunk_id: t.chunk_id, chapter_index: t.meta.chapter_index };
                  if (cid) {
                      agg[cid].mentions.push(mData);
                      (mData.grounded ? agg[cid].grounded_evidence : agg[cid].ungrounded_evidence).push(mData);
                  }
                  else state.unresolvedData.mentions.push(mData);
              });
          }
          if (t.narrativeResult) {
              (t.narrativeResult.events || []).forEach(e => {
                  var eData = { ...e, chunk_id: t.chunk_id, chapter_index: t.meta.chapter_index };
                  var resolved = false;
                  (e.participants || []).forEach(p => {
                      var cid = resolveId(p);
                      if (cid) { agg[cid].events.push(eData); resolved = true; }
                  });
                  var unresolvedParticipants = (e.participants || []).filter(p => !resolveId(p));
                  if (!resolved || unresolvedParticipants.length > 0) state.unresolvedData.events.push({ ...eData, unresolved_participants: unresolvedParticipants });
              });
              (t.narrativeResult.state_changes || []).forEach(sc => {
                  var cid = resolveId(sc.entity);
                  var scData = { ...sc, chunk_id: t.chunk_id, chapter_index: t.meta.chapter_index };
                  if (cid) agg[cid].state_changes.push(scData);
                  else state.unresolvedData.state_changes.push(scData);
              });
              (t.narrativeResult.relations || []).forEach(r => {
                  var cidS = resolveId(r.source);
                  var cidT = resolveId(r.target);
                  var rData = { ...r, chunk_id: t.chunk_id, chapter_index: t.meta.chapter_index };
                  if (cidS) agg[cidS].relations.push(rData);
                  if (cidT) agg[cidT].relations.push(rData);
                  if (!cidS || !cidT) state.unresolvedData.relations.push(rData);
              });
              (t.narrativeResult.unresolved_mentions || []).forEach(m => {
                  state.unresolvedData.unresolved_mentions.push({ ...m, chunk_id: t.chunk_id, chapter_index: t.meta.chapter_index });
              });
          }
      });

      // Sort and build timeline
      Object.values(agg).forEach(entity => {
          var bySourceOrder = (a, b) => ((a.chapter_index || 0) - (b.chapter_index || 0)) || ((a.chunk_id || 0) - (b.chunk_id || 0)) || ((a.global_start || 0) - (b.global_start || 0));
          entity.events.sort(bySourceOrder);
          entity.state_changes.sort(bySourceOrder);
          entity.relations.sort(bySourceOrder);
          var timeline = [].concat(entity.events, entity.state_changes, entity.relations).sort(bySourceOrder);
          entity.timeline = timeline;

          entity.current_state = {};
          entity.state_changes.forEach(sc => {
              if (sc.field && sc.after) entity.current_state[sc.field] = sc.after;
          });
      });

      state.aggregatedData = agg;
      await persistCurrentProject();
  }

